# Caddy đứng trước Apache: nhận HTTPS, tự xin và gia hạn chứng chỉ Let's Encrypt.
{
	servers {
		# NSG chỉ mở TCP nên không quảng cáo HTTP/3 (chạy trên UDP).
		protocols h1 h2
		# Chỉ tin CF-Connecting-IP khi request thật sự đến từ Cloudflare (https://www.cloudflare.com/ips-v4/).
		# Khách vào thẳng thì header này bị bỏ qua, nên chạy đúng cả khi bật lẫn tắt proxy Cloudflare.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
		client_ip_headers CF-Connecting-IP
	}
}

{$KIO_DOMAIN} {
	header Strict-Transport-Security "max-age=2592000"
	reverse_proxy wordpress:80 {
		# Ghi đè giá trị khách tự gửi. Apache đọc header này (docker/apache/remoteip-prod.conf).
		header_up X-Real-IP {client_ip}
	}
}

# Host lạ và truy cập thẳng bằng IP: cắt kết nối. Cache Enabler tạo thư mục cache theo Host,
# nên để Host lạ vào tới WordPress thì ai cũng làm đầy được đĩa.
http:// {
	abort
}
