{
  "name": "khieutran/kio-store",
  "description": "Kio Mobile: project học WordPress + WooCommerce. Composer chỉ dùng cho công cụ kiểm tra code (CI), không dùng lúc chạy site.",
  "type": "project",
  "license": "proprietary",
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf"
  }
}
