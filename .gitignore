*.sql
*.sql.gz
backups/

# Hệ điều hành, editor
.DS_Store
.idea/
.vscode/
*.log

# Kế hoạch cá nhân (chỉ giữ ở máy)
docs/

# Composer (công cụ kiểm tra code)
/vendor/

# Python
__pycache__/
