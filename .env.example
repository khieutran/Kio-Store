# Copy file này thành .env rồi đổi mật khẩu: cp .env.example .env

# Database
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# Site
WP_URL=http://localhost:8080
WP_TITLE="Kio Mobile"
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change-me-admin
WP_ADMIN_EMAIL=admin@kio.local

# Chỉ dùng trên server (bỏ dấu # và thay WP_URL=https://<tên miền>):
# COMPOSE_FILE=docker-compose.yml:docker-compose.vm.yml:docker-compose.prod.yml
# KIO_DOMAIN=shop.example.com
# KIO_WP_ENV=production
# KIO_WP_DEBUG=0
